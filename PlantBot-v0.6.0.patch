+package ch.yanick.plantbot
+
+import android.content.Context
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import org.json.JSONObject
+import java.net.HttpURLConnection
+import java.net.URL
+
+/** The forecast is for Gals, never a measurement inside a pot or greenhouse. */
+data class GalsWeather(
+    val fetchedAt: Long,
+    val max: List<Double>,
+    val min: List<Double>,
+    val rain: List<Double>,
+    val sunshine: List<Double>
+) {
+    val fresh: Boolean get() = System.currentTimeMillis() - fetchedAt in 0..(12 * 60 * 60 * 1000L)
+    val hot: Boolean get() = max.take(3).count { it >= 30.0 } >= 2
+    val cool: Boolean get() = max.take(3).count { it <= 12.0 } >= 2
+    val frost: Boolean get() = min.take(3).any { it <= 2.0 }
+    val rainExpected: Boolean get() = rain.take(3).any { it >= 4.0 }
+    val greenhouseHeat: Boolean get() = max.take(3).indices.any { index ->
+        max[index] >= 25.0 || (max[index] >= 18.0 && sunshine.getOrElse(index) { 0.0 } >= 7200.0)
+    }
+
+    companion object {
+        fun fromJson(raw: String): GalsWeather {
+            val root = JSONObject(raw)
+            val daily = root.getJSONObject("daily")
+            fun values(key: String): List<Double> {
+                val a = daily.getJSONArray(key)
+                return (0 until a.length()).map { a.getDouble(it) }
+            }
+            val max = values("temperature_2m_max")
+            val min = values("temperature_2m_min")
+            val rain = values("precipitation_sum")
+            val sunshine = values("sunshine_duration")
+            require(max.size >= 3 && min.size >= 3 && rain.size >= 3 && sunshine.size >= 3)
+            return GalsWeather(System.currentTimeMillis(), max, min, rain, sunshine)
+        }
+    }
+}
+
+class WeatherStore(context: Context) {
+    private val prefs = context.getSharedPreferences("gals_weather", Context.MODE_PRIVATE)
+
+    fun load(): GalsWeather? = runCatching {
+        GalsWeather(
+            prefs.getLong("updated", 0L),
+            readArray("max"),
+            readArray("min"),
+            readArray("rain"),
+            readArray("sunshine")
+        ).takeIf { it.fresh && it.max.size >= 3 && it.min.size >= 3 && it.rain.size >= 3 && it.sunshine.size >= 3 }
+    }.getOrNull()
+
+    private fun readArray(key: String): List<Double> {
+        val a = org.json.JSONArray(prefs.getString(key, "[]"))
+        return (0 until a.length()).map { a.getDouble(it) }
+    }
+
+    fun save(weather: GalsWeather) {
+        prefs.edit()
+            .putLong("updated", weather.fetchedAt)
+            .putString("max", org.json.JSONArray(weather.max).toString())
+            .putString("min", org.json.JSONArray(weather.min).toString())
+            .putString("rain", org.json.JSONArray(weather.rain).toString())
+            .putString("sunshine", org.json.JSONArray(weather.sunshine).toString())
+            .apply()
+    }
+
+    suspend fun refresh(force: Boolean = false): GalsWeather? = withContext(Dispatchers.IO) {
+        load()?.takeIf { !force && System.currentTimeMillis() - it.fetchedAt < 6 * 60 * 60 * 1000L }
+            ?.let { return@withContext it }
+        runCatching {
+            val url = URL(
+                "https://api.open-meteo.com/v1/forecast" +
+                    "?latitude=47.02802&longitude=7.04981" +
+                    "&daily=temperature_2m_max,temperature_2m_min,precipitation_sum,sunshine_duration" +
+                    "&timezone=Europe%2FZurich&forecast_days=5&models=meteoswiss_icon_seamless"
+            )
+            val connection = (url.openConnection() as HttpURLConnection).apply {
+                connectTimeout = 7000
+                readTimeout = 7000
+            }
+            try {
+                if (connection.responseCode != 200) error("HTTP ${connection.responseCode}")
+                GalsWeather.fromJson(connection.inputStream.bufferedReader().use { it.readText() })
+                    .also(::save)
+            } finally {
+                connection.disconnect()
+            }
+        }.getOrNull() ?: load()
+    }
+}
+
+data class CheckAdvice(val remaining: Int, val note: String)
+
+fun checkAdvice(plant: Plant, weather: GalsWeather?): CheckAdvice {
+    var interval = plant.intervalDays.coerceIn(2, 21)
+    val outside = plant.place == "outdoor"
+    if (outside && plant.exposure != "greenhouse" && weather?.fresh == true) {
+        if (weather.hot) interval = (interval - 1).coerceAtLeast(2)
+        if (weather.cool) interval = (interval + 1).coerceAtMost(21)
+    }
+    var remaining = interval - plant.daysSinceWatered
+    if (plant.soilState == "dry" && plant.daysSinceChecked <= 2) remaining = 0
+    if (plant.soilState in listOf("moist", "wet") && plant.daysSinceChecked <= 3) {
+        val wait = if (plant.soilState == "wet") 3 else 2
+        remaining = maxOf(remaining, wait - plant.daysSinceChecked)
+    }
+    val note = when {
+        !outside -> "Contrôle de la terre : le calendrier tient compte de votre dernier constat."
+        plant.exposure == "greenhouse" && weather?.fresh == true && weather.frost ->
+            "Serre plastique : arrosez beaucoup moins en période froide et humide. Risque de gel dehors : mesurez la température sous la serre."
+        plant.exposure == "greenhouse" && weather?.fresh == true && weather.greenhouseHeat ->
+            "Serre plastique : l'humidité peut limiter l'arrosage, mais le soleil peut assécher les pots. Vérifiez la terre, la température et aérez."
+        plant.exposure == "greenhouse" ->
+            "Sous serre : réduisez nettement l'arrosage si la terre reste humide. La pluie ne mouille pas les pots ; vérifiez la terre et le microclimat."
+        weather?.fresh != true -> "Prévisions indisponibles : vérifiez la terre et la météo locale."
+        plant.exposure == "open" && weather.rainExpected ->
+            "Précipitations prévues : vérifiez ensuite si l'eau a atteint le pot ; aucun arrosage n'est enregistré."
+        weather.hot -> "Plusieurs jours chauds : contrôlez la terre plus tôt."
+        weather.cool -> "Plusieurs jours frais : vérifiez la terre avant d'arroser."
+        else -> "Prévisions de Gals prises en compte ; vérifiez la terre avant d'arroser."
+    }
+    return CheckAdvice(remaining, note)
+}
