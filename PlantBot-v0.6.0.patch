+private fun chatGptPlantPrompt(name: String, species: String, place: String): String = """
+Je veux ajouter une plante à PlantBot. Je peux joindre une photo pour l'identification.
+Nom : ${name.ifBlank { "à déterminer" }}. Espèce : ${species.ifBlank { "à déterminer" }}.
+Emplacement : ${if (place == "indoor") "intérieur près d'une fenêtre voilée, 21-22 °C" else "extérieur à Gals, Suisse"}.
+Réponds uniquement avec un objet JSON sans bloc de code, ayant exactement ces clés :
+{"name":"nom usuel","species":"nom botanique ou identification incertaine","description":"conseils pratiques en français : lumière, vérification du substrat et arrosage, températures, saison, toxicité connue et vigilance","intervalDays":7,"place":"$place","exposure":"open"}
+intervalDays est une fréquence de VÉRIFICATION de la terre, entre 2 et 21 jours, jamais une obligation d'arroser. Si une photo ou l'identification est incertaine, indique-le dans la description et n'invente pas l'espèce. Pour une plante d'extérieur, exposure sera corrigé manuellement dans PlantBot selon qu'elle reçoit la pluie, est abritée ou sous serre. Reste concis.
+""".trimIndent()
+
+private fun parsePlantImport(raw: String): Plant {
+    require(raw.length <= 12000) { "Texte trop long." }
+    val start = raw.indexOf('{')
+    val end = raw.lastIndexOf('}')
+    require(start >= 0 && end > start) { "Copiez la réponse JSON complète de ChatGPT." }
+    val o = JSONObject(raw.substring(start, end + 1))
+    val name = o.getString("name").trim().take(100)
+    require(name.isNotBlank()) { "Le nom est manquant." }
+    val place = o.optString("place", "indoor").takeIf { it in listOf("indoor", "outdoor") } ?: "indoor"
+    val exposure = o.optString("exposure", "open").takeIf { it in listOf("open", "shelter", "greenhouse") } ?: "open"
+    return Plant(0L, name, o.optString("species").trim().ifBlank { name }.take(100),
+        o.optInt("intervalDays", 7).coerceIn(2, 21), 0L, 0,
+        description = o.optString("description").trim().take(2500),
+        place = place, exposure = exposure)
+}
