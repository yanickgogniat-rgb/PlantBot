+private fun sendWeatherAlerts(context: Context, plants: List<Plant>, weather: GalsWeather?) {
+    if (weather?.fresh != true || plants.none { it.place == "outdoor" }) return
+    if (!PlantStore(context).notificationsEnabled() || !canNotify(context)) return
+    val prefs = context.getSharedPreferences("weather_alerts", Context.MODE_PRIVATE)
+    val manager = context.getSystemService(NotificationManager::class.java)
+    fun alert(key: String, id: Int, title: String, message: String) {
+        if (System.currentTimeMillis() - prefs.getLong(key, 0L) < 20 * 60 * 60 * 1000L) return
+        manager.notify(id, NotificationCompat.Builder(context, "watering")
+            .setSmallIcon(android.R.drawable.ic_dialog_alert)
+            .setContentTitle(title)
+            .setContentText(message)
+            .setStyle(NotificationCompat.BigTextStyle().bigText(message))
+            .setAutoCancel(true)
+            .build())
+        prefs.edit().putLong(key, System.currentTimeMillis()).apply()
+    }
+    if (weather.frost) alert("frost", 1002, "PlantBot · Gel possible à Gals",
+        "Vérifiez les plantes sensibles et mesurez la température sous la serre plastique.")
+    if (weather.greenhouseHeat && plants.any { it.place == "outdoor" && it.exposure == "greenhouse" })
+        alert("heat", 1003, "PlantBot · Serre à surveiller",
+            "Chaleur possible sous le plastique : mesurez la température, aérez et vérifiez les pots.")
