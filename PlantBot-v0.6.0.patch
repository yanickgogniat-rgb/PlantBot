+private fun initializeDebugAppCheck(context: Context): String {
+    val firebaseApp = FirebaseApp.getInstance()
+    val prefsName = "com.google.firebase.appcheck.debug.store.${firebaseApp.persistenceKey}"
+    val prefs = context.getSharedPreferences(prefsName, Context.MODE_PRIVATE)
+    val key = "com.google.firebase.appcheck.debug.DEBUG_SECRET"
+    val token = prefs.getString(key, null) ?: UUID.randomUUID().toString().also {
+        prefs.edit().putString(key, it).commit()
+    }
+    FirebaseAppCheck.getInstance().installAppCheckProviderFactory(
+        DebugAppCheckProviderFactory.getInstance()
+    )
+    return token
+}
