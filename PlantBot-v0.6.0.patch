+@Composable private fun PlaceSelector(
+    place: String,
+    exposure: String,
+    onPlace: (String) -> Unit,
+    onExposure: (String) -> Unit
+) {
+    Text("Emplacement", fontWeight = FontWeight.SemiBold, color = DarkGreen)
+    Row {
+        FilterChip(selected = place == "indoor", onClick = { onPlace("indoor") }, label = { Text("Intérieur") })
+        Spacer(Modifier.width(8.dp))
+        FilterChip(selected = place == "outdoor", onClick = { onPlace("outdoor") }, label = { Text("Extérieur · Gals") })
+    }
+    if (place == "outdoor") {
+        Text("Situation actuelle du pot", fontSize = 13.sp, color = DarkGreen)
+        listOf(
+            "open" to "Exposé à la pluie",
+            "shelter" to "À l’abri de la pluie",
+            "greenhouse" to "Sous serre plastique"
+        ).forEach { (value, title) ->
+            Row(verticalAlignment = Alignment.CenterVertically, modifier = Modifier.clickable { onExposure(value) }) {
+                RadioButton(selected = exposure == value, onClick = { onExposure(value) })
+                Text(title)
+            }
+        }
+        if (exposure == "greenhouse") Text(
+            "Changez ce réglage quand vous installez ou retirez la serre. En hiver, espacez beaucoup les arrosages si la terre reste humide ; la température sous le plastique n’est pas mesurée.",
+            fontSize = 12.sp, color = Color.Gray
+        )
+    }
+}
